# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=doi-thanh-chuoi-ngau-nhien-dai

# Tài khoản quản trị mặc định sử dụng trong local/Docker seed
ADMIN_EMAIL=admin@sportzone.local
ADMIN_PASSWORD=Admin@123

# CSDL: Để trống sẽ dùng SQLite (sportzone.db) cho môi trường phát triển cục bộ
# Docker Compose hoặc Production dùng MySQL 8:
# DATABASE_URL=mysql+pymysql://sportzone:matkhau@localhost:3306/sportzone?charset=utf8mb4
DATABASE_URL=

# Email (SMTP). Có thể dùng Gmail + App Password hoặc Mailtrap khi test
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=SportZone <no-reply@sportzone.local>

# -----------------------------------------------------------------------------
# CẤU HÌNH CỔNG THANH TOÁN TRỰC TUYẾN
# -----------------------------------------------------------------------------
# 1. Môi trường Báo cáo đồ án / Phát triển (Demo):
#    PAYMENT_MOCK_ENABLED=true (sử dụng cổng thanh toán mô phỏng nội bộ)
# 2. Môi trường Triển khai thực tế (Production):
#    PAYMENT_MOCK_ENABLED=false (hệ thống tự động khóa cổng mô phỏng, chỉ dùng COD)
PAYMENT_MOCK_ENABLED=true

# Thông tin cổng VNPay chính thức (chỉ điền khi triển khai thực tế có hợp đồng doanh nghiệp)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://127.0.0.1:5000/payment/vnpay/return

# Rate limit (production nên dùng Redis, ví dụ redis://redis:6379/0)
RATELIMIT_STORAGE_URI=memory://
